# Neon PostgreSQL — get from Neon console → your project → Connect button
DATABASE_URL=postgresql://user:password@host/crypto_news_trader?sslmode=require

# OpenAI — GPT-4o-mini sentiment scoring
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Kraken API — spot trading (paper mode by default)
# https://www.kraken.com/u/security/api
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Push notifications
# https://ntfy.sh/
NTFY_TOPIC=news-bot

# Trading mode
LIVE_TRADING=false
NEXT_PUBLIC_LIVE_TRADING=false

# Cron authentication — generate a long random string
CRON_SECRET=
NEXT_PUBLIC_CRON_SECRET=

# Public deployment URL
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
