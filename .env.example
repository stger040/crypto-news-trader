# Kraken API — same keys as sibling TA bot
# https://www.kraken.com/u/security/api
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# OpenAI — sentiment scoring (gpt-4o-mini)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Upstash Redis — same DB as sibling; this bot uses news: prefix only
# https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# CryptoPanic — dedicated key for this project
# https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=

# Push notifications (separate topic from TA bot)
# https://ntfy.sh/
NTFY_TOPIC=news-bot

# Trading mode — keep false until validated
LIVE_TRADING=false
NEXT_PUBLIC_LIVE_TRADING=false

# Cron auth — generate a long random string
CRON_SECRET=
NEXT_PUBLIC_CRON_SECRET=

# Public site URL (Vercel deployment URL)
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
